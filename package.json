{
  "name": "@cocreate/utils",
  "version": "1.57.0",
  "description": "A simple utils component in vanilla javascript. Easily configured using HTML5 attributes and/or JavaScript API.",
  "keywords": [
    "utils",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client",
      "server"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "A simple utils component in vanilla javascript. Easily configured using HTML5 attributes and/or JavaScript API.",
      "client": {
        "source": "src/browser.js",
        "declarative": {
          "selectors": [
            "${selector}"
          ],
          "attributes": [
            {
              "name": "contenteditable"
            },
            {
              "name": "eid"
            },
            {
              "name": "key | {prefix}-key",
              "valueType": "string",
              "role": "Names the property read or written by getData and setData."
            },
            {
              "name": "get-data | {prefix}-get-data",
              "valueType": "boolean-like string",
              "acceptedValues": [
                "false"
              ],
              "role": "When false, excludes the element from getData collection."
            },
            {
              "name": "set-data | {prefix}-set-data",
              "valueType": "boolean-like string",
              "acceptedValues": [
                "false"
              ],
              "role": "When false, excludes the element from setData mapping."
            }
          ]
        },
        "api": {
          "exports": [
            "ObjectId",
            "astAsync",
            "astSync",
            "caseHandler",
            "checkMediaQueries",
            "checkValue",
            "cloudProviders",
            "convertValue",
            "createUpdate",
            "cssPath",
            "decodeValue",
            "dotNotationToObject",
            "encodeValue",
            "escapeHtml",
            "getAttributeNames",
            "getAttributes",
            "getClientInfo",
            "getClockOffset",
            "getData",
            "getRelativePath",
            "getValueAttribute",
            "getValueFromObject",
            "hasSelection",
            "isEqualArray",
            "isEqualObject",
            "isValidDate",
            "objectToDotNotation",
            "objectToSearchParams",
            "parseJson",
            "parseTextToHtml",
            "processOperators",
            "processOperatorsAsync",
            "queryData",
            "queryElements",
            "queryElementsAll",
            "regex",
            "resolveProperty",
            "searchData",
            "searchParamsToObject",
            "setAttributeNames",
            "setData",
            "sortData",
            "toArray",
            "toBoolean",
            "transformValue",
            "ulid",
            "ulidDecode",
            "uuid",
            "valueHandlers"
        ],
        "methods": [
          {
            "name": "getData",
            "signature": "getData({ form, prefix })",
            "description": "Collects values from elements with key or {prefix}-key and converts dotted keys into nested objects."
          }
        ]
        }
      },
      "server": {
        "source": "src/server.js",
        "declarative": {
          "selectors": [
            "${selector}"
          ]
        },
        "api": {
          "exports": [
            "HTMLScanner",
            "ObjectId",
            "astAsync",
            "astSync",
            "caseHandler",
            "checkValue",
            "cloudProviders",
            "convertValue",
            "createUpdate",
            "decodeValue",
            "dotNotationToObject",
            "encodeValue",
            "escapeHtml",
            "getAttributeNames",
            "getAttributes",
            "getClientInfo",
            "getClockOffset",
            "getRelativePath",
            "getValueAttribute",
            "getValueFromObject",
            "isEqualArray",
            "isEqualObject",
            "isValidDate",
            "objectToDotNotation",
            "objectToSearchParams",
            "parseJson",
            "parseTextToHtml",
            "processOperators",
            "processOperatorsAsync",
            "queryData",
            "regex",
            "resolveProperty",
            "searchData",
            "searchParamsToObject",
            "security",
            "setAttributeNames",
            "sortData",
            "toArray",
            "toBoolean",
            "transformValue",
            "ulid",
            "ulidDecode",
            "uuid",
            "valueHandlers"
          ]
        }
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/cocreatejs/CoCreate-utils.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-utils/issues"
  },
  "homepage": "https://cocreate.app/docs/utils",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/server.js",
  "server": "./src/server.js",
  "browser": "./src/browser.js",
  "exports": {
    ".": {
      "browser": "./src/browser.js",
      "node": "./src/server.js",
      "default": "./src/browser.js"
    },
    "./selection": "./src/modules/selection.js",
    "./iframe": "./src/modules/iframe.js",
    "./browser": "./src/browser.js",
    "./server": "./src/server.js"
  },
  "sideEffects": false,
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "dependencies": {
    "entities": "^6.0.1"
  }
}
